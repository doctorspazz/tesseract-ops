---
// src/pages/about.astro — committed two-column About.
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Placeholder from '../components/Placeholder.astro';

const posts = await getCollection('posts', ({ data }) => !data.draft);


const stats: [string, string][] = [
  ['POSTS',  String(posts.length)],
  ['SERIES', '3'],
  ['UPTIME', '67d'],
  ['COFFEE', '∞'],
];
---

<BaseLayout title="About" description="About Tesseract-Ops · Shaun Seaver">
  <section class="about-hero">
    <div class="eyebrow eyebrow--accent about-hero__eyebrow">// ABOUT</div>

  </section>

  <section class="about-grid">
    <aside>
<div class="about-portrait">
  <img 
    src="/images/portrait.png" 
    alt="Shaun Seaver" 
    class="about-portrait__img"
  />
</div>
      </div>
      <div class="about-side__name">Shaun Seaver</div>
      <div class="about-side__role"> platform operations eng · louisville, ky </div>



      <div class="about-contact">
        <div class="eyebrow" style="margin-bottom: 8px;">// CONTACT</div>
        shaun_seaver@icloud.com<br />
        <a href="https://github.com/doctorspazz">github/doctorspazz</a><br />

      </div>
    </aside>

    <div class="about-body">
      <p>
        <strong>I created Tesseract-Ops as a place to share my thoughts and experiences with the latest on AI tooling and automation.
        I'm Shaun — a platform operations engineer who got curious about how companies are actually integrating AI into their existing workflows.
      </p>
      <p>
I'm writing this to help document my findings in the event that other's are also interested. It's also a great opportunity to work on writing skills, something I've always wanted to do.
      </p>

      <h2>What lives here</h2>
      <ul>
        <li><strong>Deep-dives</strong> — Technical posts about AI/Automation.</li>
        <li><strong>Notes</strong> — half-baked TILs. Lower bar, faster cadence.</li>
      </ul>


      <h2>What's not here</h2>
      <p>
        No newsletter. No sponsorship. No "10× your smart home" anything. No analytics
        tracking individual visits. If something seems wrong on a post, the most useful
        thing you can do is email me — I publish corrections inline.
      </p>
      <p>Thanks for reading.</p>
    </div>
  </section>
</BaseLayout>
