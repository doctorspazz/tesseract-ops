---
// src/components/PostRow.astro
// One row in the blog index. Three columns: date / title (+series eyebrow + dek) / tags.
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'posts'>;
  series?: CollectionEntry<'series'>;
  current?: boolean;
}
const { post, series, current = false } = Astro.props;
const d = post.data;
const dateIso = d.date.toISOString().slice(0, 10);
const inSeries = !!series && !!d.part;
const pad = (n: number) => String(n).padStart(2, '0');
---

<li class:list={['post-row', current && 'is-current', inSeries && 'has-series']}>
  <span class="post-row__date">{dateIso}</span>
  <div>
    {inSeries && (
      <div class="post-row__eyebrow">
        {series!.data.name} &nbsp;·&nbsp; Part {pad(d.part!)} / {pad(series!.data.total)}
      </div>
    )}
    <a href={`/posts/${post.id}`} class="post-row__title">
      {d.title}
      {current && <span class="post-row__new">NEW</span>}
    </a>
    <p class="post-row__dek">{d.dek}</p>
  </div>
  <div class="post-row__tags">
    <ul class="tags" role="list">
      {d.tags.map(t => (<li><a href={`/tags/${t}`} class="tag">#{t}</a></li>))}
    </ul>
  </div>
</li>
