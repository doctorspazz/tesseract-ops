---
// src/components/Footer.astro
interface Props {
  note?: string;
}
const { note = '© 2026 tesseract-ops · built with astro' } = Astro.props;
---

<footer class="site-footer">
  <span>{note}</span>
  <span class="site-footer__links">
    <a href="/rss.xml">~/rss</a>
    <a href="https://github.com/mira" rel="me">~/git</a>
    <a href="https://hachyderm.io/@mira" rel="me">~/mastodon</a>
  </span>
</footer>
