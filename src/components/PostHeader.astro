---
// src/components/PostHeader.astro
// The chunk above the article body — meta strip + title block + hero.
// Renders from a post's frontmatter (and the resolved series record).
import type { CollectionEntry } from 'astro:content';
import Tags from './Tags.astro';
import Placeholder from './Placeholder.astro';

interface Props {
  post: CollectionEntry<'posts'>;
  series?: CollectionEntry<'series'>;
}
const { post, series } = Astro.props;
const d = post.data;

const dateLong = d.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
const pad = (n: number) => String(n).padStart(2, '0');

const meta = [
  ['SERIES',  series ? series.data.name.toUpperCase() : d.kind.toUpperCase()],
  ['PART',    d.part && series ? `${pad(d.part)} / ${pad(series.data.total)}` : '—'],
  ['AUTHOR',  'Shaun Seaver'],
  ['POSTED',  dateLong],
  ['READ',    d.readTime.toUpperCase()],
];
---

<section class="post-header">
  {/* Metadata strip */}
  <div class="post-header__meta-strip">
    {meta.map(([k, v]) => (
      <div class="post-header__meta-cell">
        <span>{k}</span>
        <span class="post-header__meta-value">{v}</span>
      </div>
    ))}
  </div>

  {/* Title block */}
  <div class="post-header__title-block">
    <div class="post-header__index">
      POST<br/>
      <span>0x{d.part ? pad(d.part) : '—'}</span>
    </div>
    <div>
      <h1 class="post-header__title">{d.title}</h1>
      <p class="post-header__dek">{d.dek}</p>
      <div class="post-header__tags">
        <Tags tags={d.tags} />
      </div>
    </div>
  </div>

  {/* Hero — only renders when hero frontmatter is set */}
  {d.hero && (
    <figure class="post-header__hero">
      <img
        src={d.hero.src}
        alt={d.heroCaption ?? d.title}
        width={d.heroWidth ?? d.hero.width}
        height={d.hero.height}
        style={d.heroWidth ? `width: ${d.heroWidth}px; height: auto; display: block; margin: 0 auto;` : `display: block; margin: 0 auto;`}

        
      />
      {d.heroCaption && (
        <figcaption class="post-header__hero-caption">
          <span>FIG 01 · {d.heroCaption}</span>
          <span>exif: f/4.0 · 1/60 · ISO 800</span>
        </figcaption>
      )}
    </figure>
  )}
</section>